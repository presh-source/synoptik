# Example Environment Variables for Frontend
# Copy this file to .env.local and fill in the actual values

# REST API Configuration
VITE_API_URL=https://api.domain.io

# Sentry Configuration
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
VITE_APP_VERSION=1.0.0

# AppSync GraphQL API Configuration
# Get these values after deploying AppSync infrastructure:
# 1. Run: cd backend && terraform output
# 2. Or run: ./scripts/get-appsync-env-vars.sh
# 3. Or retrieve from AWS Secrets Manager:
#    aws secretsmanager get-secret-value --secret-id dev-domain-appsync-api-key

VITE_DASHBOARD_APPSYNC_API_URL=https://xxxxx.appsync-api.us-east-1.amazonaws.com/graphql
VITE_APPSYNC_API_KEY=da2-xxxxxxxxxxxxxxxxxxxxx
VITE_APPSYNC_REALTIME_URL=wss://xxxxx.appsync-realtime-api.us-east-1.amazonaws.com/graphql

# For custom domain setup (after task 6 is complete):
# VITE_DASHBOARD_APPSYNC_API_URL=https://graphql.domain.io/graphql
# VITE_APPSYNC_REALTIME_URL=wss://graphql.domain.io/graphql/realtime
